import { LineEdit } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

component NavButton inherits Rectangle {
    in property <string> icon;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: Theme.border-radius;
    background: touch.pressed ? Theme.selected :
                touch.has-hover ? Theme.surface-hover :
                transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.icon;
        color: Theme.text-primary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Toolbar inherits Rectangle {
    in-out property <string> current-path: "/";

    callback navigate-forward();
    callback navigate-back();
    callback navigate-up();
    callback path-changed();
    callback refresh();

    height: 46px;
    background: Theme.surface;

    // Separador inferior
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: Theme.padding-medium;
        padding-right: Theme.padding-medium;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 4px;

        NavButton {
            icon: "←";
            clicked => { navigate-back(); }
        }
        NavButton {
            icon: "→";
            clicked => { navigate-forward(); }
        }
        NavButton {
            icon: "↑";
            clicked => { navigate-up(); }
        }

        Rectangle { width: 4px; }

        // Barra de endereço
        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            border-radius: Theme.border-radius;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            LineEdit {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                text <=> current-path;
                placeholder-text: "Caminho...";
                // Só navega ao pressionar Enter, não a cada tecla
                accepted => {
                    root.path-changed();
                }
            }
        }

        Rectangle { width: 4px; }

        NavButton {
            icon: "⟳";
            clicked => { refresh(); }
        }
    }
}
