import { LineEdit, ComboBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

component NavButton inherits Rectangle {
    in property <string> icon;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: Theme.border-radius;
    background: touch.pressed ? Theme.selected :
                touch.has-hover ? Theme.surface-hover :
                transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.icon;
        color: Theme.text-primary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Toolbar inherits Rectangle {
    in-out property <string> current-path: "/";
    in-out property <string> search-query: "";
    in-out property <int> sort-index: 0;
    in-out property <bool> sort-ascending: true;

    callback navigate-forward();
    callback navigate-back();
    callback navigate-up();
    callback path-changed();
    callback refresh();
    callback search-changed();
    callback sort-changed();

    height: 46px;
    background: Theme.surface;

    // Separador inferior
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: Theme.padding-medium;
        padding-right: Theme.padding-medium;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 4px;

        NavButton {
            icon: "←";
            clicked => { navigate-back(); }
        }
        NavButton {
            icon: "→";
            clicked => { navigate-forward(); }
        }
        NavButton {
            icon: "↑";
            clicked => { navigate-up(); }
        }

        Rectangle { width: 4px; }

        // Barra de endereço
        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            border-radius: Theme.border-radius;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            LineEdit {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                text <=> current-path;
                placeholder-text: "Caminho...";
                // Só navega ao pressionar Enter, não a cada tecla
                accepted => {
                    root.path-changed();
                }
            }
        }

        Rectangle { width: 4px; }

        NavButton {
            icon: "⟳";
            clicked => { refresh(); }
        }

        Rectangle { width: 4px; }

        // Barra de busca
        Rectangle {
            width: 150px;
            height: 30px;
            border-radius: Theme.border-radius;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            LineEdit {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                text <=> root.search-query;
                placeholder-text: "Buscar...";
                accepted => {
                    root.search-changed();
                }
            }
        }

        Rectangle { width: 4px; }

        // Ordenação
        ComboBox {
            width: 120px;
            height: 30px;
            model: ["Nome", "Tamanho", "Data", "Tipo"];
            current-index <=> root.sort-index;
            selected => {
                root.sort-changed();
            }
        }

        Rectangle { width: 4px; }

        // Toggle crescente / decrescente
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: Theme.border-radius;
            border-width: 1px;
            border-color: Theme.border;
            background: dir-touch.pressed ? Theme.selected :
                        dir-touch.has-hover ? Theme.surface-hover :
                        transparent;

            dir-touch := TouchArea {
                clicked => {
                    root.sort-ascending = !root.sort-ascending;
                    root.sort-changed();
                }
            }

            Text {
                text: root.sort-ascending ? "↑" : "↓";
                color: Theme.text-primary;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
