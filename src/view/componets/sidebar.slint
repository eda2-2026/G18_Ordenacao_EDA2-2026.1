import { ScrollView } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export struct Location {
    name: string,
    path: string,
    icon: string,
}

export component Sidebar inherits Rectangle {
    in property <[Location]> locations: [];
    in property <int> selected-index: -1;

    callback location-clicked(int);

    width: 200px;
    background: Theme.surface;

    // Separador direito
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        // Header da sidebar
        Rectangle {
            height: 36px;
            background: Theme.background;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }

            Text {
                x: Theme.padding-large;
                text: "LOCAIS";
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
                height: parent.height;
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Theme.padding-medium;
                spacing: 2px;

                for location[index] in locations: Rectangle {
                    height: 34px;
                    background: index == selected-index ? Theme.selected :
                               touch.has-hover ? Theme.surface-hover :
                               transparent;
                    border-radius: Theme.border-radius;

                    touch := TouchArea {
                        clicked => {
                            root.location-clicked(index);
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.padding-medium;
                        padding-right: Theme.padding-small;
                        spacing: 8px;

                        Text {
                            text: location.icon;
                            font-size: 14px;
                            width: 20px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: location.name;
                            color: index == selected-index ? Theme.text-primary : Theme.text-secondary;
                            font-size: Theme.font-medium;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
