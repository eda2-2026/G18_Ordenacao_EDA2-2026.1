import { Toolbar } from "./componets/toolbar.slint";
import { Sidebar, Location } from "./componets/sidebar.slint";
import { FileList } from "./componets/file-list.slint";
import { FileInfo } from "./componets/file-item.slint";
import { StatusBar } from "./componets/statusbar.slint";
import { Theme } from "./styles/theme.slint";

export component MainWindow inherits Window {
    title: "Rusty Explorer";
    min-width: 800px;
    min-height: 500px;
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.background;

    in-out property <string> current-path: "/";
    in-out property <[FileInfo]> files: [];
    in-out property <[Location]> locations: [];
    in-out property <int> selected-file-index: -1;
    in-out property <int> selected-location-index: -1;

    in-out property <string> search-query: "";
    in-out property <int> sort-index: 0;
    in-out property <bool> sort-ascending: true;
    in-out property <string> sort-info: "";
    in-out property <string> search-info: "";
    in-out property <string> detailed-metrics: "";
    in-out property <bool> show-metrics: false;

    callback navigate-back();
    callback navigate-forward();
    callback navigate-up();
    callback navigate-to(string);
    callback refresh-files();
    callback file-selected(int);
    callback location-selected(int);
    callback file-double-click(int);
    callback search-changed(string);
    callback sort-requested(string);

    HorizontalLayout {
        spacing: 0px;

        sidebar := Sidebar {
            locations: root.locations;
            selected-index: root.selected-location-index;
            location-clicked(index) => {
                root.location-selected(index);
            }
        }

        VerticalLayout {
            spacing: 0px;

            toolbar := Toolbar {
                current-path <=> root.current-path;
                search-query <=> root.search-query;
                sort-index <=> root.sort-index;
                sort-ascending <=> root.sort-ascending;
                navigate-back => { root.navigate-back(); }
                navigate-forward => { root.navigate-forward(); }
                navigate-up => { root.navigate-up(); }
                path-changed => { root.navigate-to(root.current-path); }
                refresh => { root.refresh-files(); }
                search-changed => { root.search-changed(root.search-query); }
                sort-changed => {
                    root.sort-requested(
                        toolbar.sort-index == 0 ? "Nome" :
                        toolbar.sort-index == 1 ? "Tamanho" :
                        toolbar.sort-index == 2 ? "Data" : "Tipo"
                    );
                }
            }

            file-list := FileList {
                vertical-stretch: 1;
                files: root.files;
                selected-index: root.selected-file-index;

                file-double-click(index) => {
                    root.file-double-click(index);
                }
                file-clicked(index) => {
                    root.file-selected(index);
                }
            }

            if root.show-metrics : Rectangle {
                background: Theme.surface;
                height: 120px;
                border-width: 1px;
                border-color: Theme.border;
                
                VerticalLayout {
                    padding: Theme.padding-large;
                    
                    Text {
                        text: root.detailed-metrics;
                        color: Theme.text-primary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                        vertical-alignment: top;
                        horizontal-alignment: left;
                    }
                }
            }

            statusbar := StatusBar {
                item-count: root.files.length + " itens";
                selected-info: root.selected-file-index >= 0 ?
                              root.files[root.selected-file-index].name : "";
                sort-info: root.sort-info;
                search-info: root.search-info;
                disk-space: "";
                toggle-metrics => { root.show-metrics = !root.show-metrics; }
            }
        }
    }
}
