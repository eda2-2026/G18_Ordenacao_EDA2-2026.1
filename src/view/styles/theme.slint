export global Theme {
    // Cores principais
    out property <color> background: #1e1e2e;
    out property <color> surface: #2a2a3d;
    out property <color> surface-hover: #363650;
    out property <color> surface-alt: #252538;
    out property <color> primary: #7c3aed;
    out property <color> text-primary: #e0e0f0;
    out property <color> text-secondary: #9090b0;
    out property <color> border: #3a3a55;
    out property <color> selected: #4c1d95;
    out property <color> selected-hover: #5b21b6;
    out property <color> separator: #2e2e45;
    out property <color> icon-dir: #f59e0b;
    out property <color> icon-file: #60a5fa;

    // Tamanhos
    out property <length> padding-small: 4px;
    out property <length> padding-medium: 8px;
    out property <length> padding-large: 16px;
    out property <length> border-radius: 4px;

    // Fontes
    out property <length> font-small: 12px;
    out property <length> font-medium: 13px;
    out property <length> font-large: 15px;
}
